{
  "name": "xyw",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "build:native": "clang++ -std=c++17 -fexceptions -ObjC++ -isysroot /Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk -I node_modules/node-addon-api -I /opt/homebrew/include/node -framework CoreGraphics -framework Carbon -framework Foundation -undefined dynamic_lookup -dynamiclib -o mac-coregraphics/build/Release/mac-coregraphics.node mac-coregraphics/src/main.mm",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:build": "npm run build && npm run build:native && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist:mac:arm64": "npm run build && npm run build:native && npx electron-builder --mac dmg --arm64 --publish never",
    "dist:mac": "npm run build && npm run build:native && npx electron-builder --mac dir --publish never",
    "build:win-native": "node-gyp rebuild --directory=win-input",
    "dist:win": "npm run build && npm run build:win-native && npx electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.1",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.2.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.gojocloud.campus-network-connector",
    "productName": "Campus Network Connector",
    "icon": "build/app-icon.png",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "backend/**/*",
      "mac-coregraphics/**/*.node",
      "mac-coregraphics/index.js",
      "win-input/**/*.node",
      "win-input/index.js",
      "package.json"
    ],
    "afterPack": "electron/after-pack.cjs",
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null,
      "artifactName": "${productName}-mac-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-win-${version}.${ext}"
    }
  }
}
