{
  "name": "xyw",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "backend": "cd backend && uvicorn main:app --reload --port 51888",
    "electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "electron:build": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "bundle:python": "bash scripts/bundle-python-runtime.sh",
    "dist:mac": "npm run bundle:python && npm run build && npx electron-builder --mac dir --publish never",
    "dist:win": "npm run build && npx electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "shadcn": "^4.0.5",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "electron": "^41.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.gojocloud.campus-network-connector",
    "productName": "Campus Network Connector",
    "icon": "build/app-icon.png",
    "asar": true,
    "asarUnpack": [
      "backend/**/*"
    ],
    "extraResources": [
      {
        "from": "python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "backend/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null,
      "artifactName": "${productName}-mac-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-win-${version}.${ext}"
    }
  }
}
